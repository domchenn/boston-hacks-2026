{
  "name": "breadcrumb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @breadcrumb/web --",
    "dev:api": "npm run dev -w @breadcrumb/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces --if-present",
    "preview": "npm run preview -w @breadcrumb/web --",
    "db:new": "supabase migration new",
    "db:push": "supabase db push --remote",
    "db:status": "supabase migration list --remote",
    "db:types": "supabase gen types typescript --remote > apps/web/src/types/database.types.tmp && mv apps/web/src/types/database.types.tmp apps/web/src/types/database.types.ts",
    "test:db": "supabase test db",
    "branches:prune": "bash scripts/prune-merged-branches.sh"
  },
  "devDependencies": {
    "supabase": "^3.2.0"
  }
}
