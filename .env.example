# Copy to .env and fill in from Supabase Dashboard → Project Settings → API.
# Only the PUBLISHABLE (anon) key belongs here. Never put the service-role / secret key in frontend env.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: Google Maps browser key (Maps JavaScript API + Directions API enabled).
# Restrict it to HTTP referrers: http://localhost:5173/* and your Vercel domain.
# Without it, maps fall back to a list of stops with "Open in Google Maps" links.
VITE_GOOGLE_MAPS_API_KEY=
