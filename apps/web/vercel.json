{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci -w @breadcrumb/web --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/trails/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|facebookexternalhit|embedly|preview|slack|discord|whatsapp|telegram|twitter|linkedin|skype|pinterest|redditbot|applebot|iframely).*"
        }
      ],
      "destination": "/api/og?id=:id"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ]
}
