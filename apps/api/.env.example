# Local settings for the API (copy to apps/api/.env). Only public values belong here:
# the API verifies logins with Supabase's public keys and needs no secret.
SUPABASE_URL=https://your-project-ref.supabase.co
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# APP_ENV=local
# PORT=3001
# LOG_LEVEL=info
