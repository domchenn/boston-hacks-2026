{
  "name": "@breadcrumb/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Breadcrumb iOS and Android app (Expo). Talks to the Breadcrumb API through @breadcrumb/contracts.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "tsc -b ../../packages/contracts && expo start",
    "ios": "tsc -b ../../packages/contracts && expo start --ios",
    "typecheck": "tsc -b ../../packages/contracts && tsc --noEmit",
    "lint": "eslint . && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-tokens.mjs",
    "build": "tsc -b ../../packages/contracts && expo export --platform ios --output-dir dist"
  },
  "dependencies": {
    "@breadcrumb/contracts": "*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.2",
    "aes-js": "^3.1.2",
    "expo": "~58.1.0",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.9",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.33",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.15",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.82.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/aes-js": "^3.1.4",
    "@types/react": "~19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
