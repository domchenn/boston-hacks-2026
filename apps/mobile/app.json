{
  "expo": {
    "name": "Breadcrumb",
    "slug": "breadcrumb",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "breadcrumb",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F6F2",
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6F2",
          "image": "./assets/splash-icon.png",
          "imageWidth": 96
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
