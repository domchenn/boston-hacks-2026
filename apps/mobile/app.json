{
  "expo": {
    "name": "Breadcrumb",
    "slug": "breadcrumb",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "breadcrumb",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F6F2",
    "ios": {
      "bundleIdentifier": "boston.breadcrumb.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6F2",
          "image": "./assets/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Breadcrumb uses your photo library so you can add photos of the places on a trail.",
          "cameraPermission": "Breadcrumb uses the camera so you can take photos of the places on a trail.",
          "microphonePermission": false
        }
      ]
    ],
    "android": {
      "package": "boston.breadcrumb.app"
    }
  }
}
